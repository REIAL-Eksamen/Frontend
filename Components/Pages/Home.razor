@page "/hjem"
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Hjem - FitLife</PageTitle>

@{
    var membershipStatus = "Premium";
}

<div class="home-container">

    <div class="hero-banner banner-1">
        <div class="banner-overlay">
            @if (membershipStatus == "Standard")
            {
                <p class="banner-eyebrow">DIT NÆSTE SKRIDT</p>
                <h2 class="banner-title">OPGRADER TIL PREMIUM<br />OG OPNÅ FLERE FORDELE</h2>
                <p class="banner-desc">Få adgang til alle hold, personlig træning og eksklusive events på tværs af alle centre.</p>
                <a href="/medlemskab" class="btn-banner">SE PREMIUM</a>
            }
            else
            {
                <p class="banner-eyebrow">EKSKLUSIVT FOR PREMIUM MEDLEMMER</p>
                <h2 class="banner-title">HUSK AT TILMELDE DIG<br />EKSKLUSIVT EVENT JUNI</h2>
                <p class="banner-desc">Begrænset antal pladser — kun for Premium medlemmer. Sikr din plads i dag.</p>
                <a href="/bookhold" class="btn-banner">TILMELD NU</a>
            }
        </div>
    </div>

    <div class="hero-banner banner-2">
        <div class="banner-overlay">
            <p class="banner-eyebrow">INKLUDERET I ALLE PREMIUM ABONNEMENTER</p>
            <h2 class="banner-title">BOOK ET HOLD I<br />NÆRHEDEN AF DIG</h2>
            <p class="banner-desc">Over 200 ugentlige hold på tværs af alle FitLife centre i Danmark.</p>
            <a href="/bookhold" class="btn-banner">BOOK HOLD</a>
        </div>
    </div>

    <footer class="home-footer">
        <div class="footer-section">
            <h4>FitLife Digital</h4>
            <p>CVR: 12 34 56 78</p>
            <p>Scandinavian Center, Åboulevarden 1, 8000 Aarhus C</p>
        </div>
        <div class="footer-section">
            <h4>Hjælp</h4>
            <p>Kundeservice: +45 70 20 30 40</p>
            <p>support@fitlife.dk</p>
        </div>
        <div class="footer-section">
            <h4>Følg os</h4>
            <p>Instagram · Facebook · TikTok</p>
        </div>
    </footer>

</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "page-hjem");
        }
    }

    public void Dispose()
    {
        JS.InvokeVoidAsync("document.body.classList.remove", "page-hjem");
    }
}