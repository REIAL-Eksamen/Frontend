@page "/profil"

<PageTitle>Min Profil - FitLife</PageTitle>

<div class="profil-container">
    <div class="profil-header">
        <div class="profil-avatar">👤</div>
        <div class="profil-navn">
            <h1>Enni Korhonen</h1>
            <p>Medlem siden januar 2026</p>
        </div>
    </div>

    <div class="profil-kort">
        <h2>Personlige oplysninger</h2>
        <div class="profil-felt">
            <span class="felt-label">Fulde navn</span>
            <span class="felt-value">Enni Korhonen</span>
        </div>
        <div class="profil-felt">
            <span class="felt-label">Email</span>
            <span class="felt-value">enni@fitlife.dk</span>
        </div>
        <div class="profil-felt">
            <span class="felt-label">Telefon</span>
            <span class="felt-value">+45 12 34 56 78</span>
        </div>
        <button class="btn-rediger">Rediger oplysninger</button>
    </div>

    <div class="profil-kort">
        <h2>Medlemskab</h2>
        <div class="profil-felt">
            <span class="felt-label">Type</span>
            <span class="felt-value">Premium</span>
        </div>
        <div class="profil-felt">
            <span class="felt-label">Status</span>
            <div class="membership-aktiv">
                <span class="badge-aktiv">● Aktiv</span>
                <button class="btn-opsig">Opsig medlemskab</button>
            </div>
        </div>
    </div>
</div>