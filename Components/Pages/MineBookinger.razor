@page "/minebookinger"
@using Frontend.Models
@using Frontend.Services
@inject UserClientService UserService
@inject BookingClientService BookingService
@inject ClassClientService ClassService
@rendermode InteractiveServer

<PageTitle>Mine Bookinger - FitLife</PageTitle>

<div class="bookinger-header">
    <h1>MINE BOOKINGER</h1>
</div>

<div class="booking-list">
    @if (bookinger == null)
    {
        <p style="color:white; padding: 1rem">Indlæser...</p>
    }
    else if (!bookinger.Any())
    {
        <p style="color:white; padding: 1rem">Du har ingen bookinger endnu.</p>
    }
    else
    {
        @foreach (var booking in bookinger)
        {
            var classInfo = classes.GetValueOrDefault(booking.ClassSessionId);
            <div class="booking-item">
                <div class="booking-item-top">
                    <span><strong>@(classInfo?.ClassName ?? "Ukendt hold")</strong></span>
                    <span>@(classInfo?.CenterName ?? "")</span>
                    <span>@(classInfo?.ClassroomName ?? "")</span>
                    <span>@(classInfo?.InstructorName ?? "")</span>
                    <span>@(classInfo?.StartTime?.ToLocalTime().ToString("dd/MM HH:mm") ?? "")</span>
                    <span class="@(booking.Status == BookingStatus.Confirmed ? "status-confirmed" : "status-cancelled")">
                        @booking.Status
                    </span>
                    @if (booking.Status == BookingStatus.Confirmed)
                    {
                        <button class="btn-afmeld" @onclick="() => AfmeldBooking(booking.ClassBookingId!)">AFMELD</button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<BookingModel>? bookinger;
    private Dictionary<string, ClassOverviewModel> classes = new();

    protected override async Task OnInitializedAsync()
    {
        var user = await UserService.GetCurrentUser();
        if (user == null) return;

        var allClasses = await ClassService.GetClassOverview();
        classes = allClasses.ToDictionary(c => c.Id);

        bookinger = await BookingService.GetBookingsByUserId(user.Id!);
    }

    private async Task AfmeldBooking(string bookingId)
    {
        await BookingService.CancelBooking(bookingId);
        var user = await UserService.GetCurrentUser();
        if (user != null)
            bookinger = await BookingService.GetBookingsByUserId(user.Id!);
    }
}