@page "/træningsplaner"

<PageTitle>Træningsplaner - FitLife</PageTitle>

<div class="plans-page">
    <div class="plans-overlay">

        <div class="plans-header">
            <h1>TRÆNINGSPLANER</h1>
            <p>Find en plan der matcher dine mål, dit niveau og din træningsstil.</p>
        </div>

        <!-- FILTERS -->

        <div class="plan-filters">
            <button class="filter-btn active">ALLE PLANER</button>
            <button class="filter-btn">STYRKE</button>
            <button class="filter-btn">FAT LOSS</button>
            <button class="filter-btn">PERFORMANCE</button>
            <button class="filter-btn">BEGINER</button>
        </div>

        <!-- SCROLLABLE CONTAINER -->

        <div class="plans-container">

            <div class="plans-grid">

                <!-- ROW 1 -->

                <div class="plan-card">
                    <div class="plan-image fullbody"></div>

                    <div class="plan-content">
                        <span class="plan-level">BEGINER</span>

                        <h2>FULL BODY START</h2>

                        <p>
                            Kom godt i gang med styrketræning gennem simple full body workouts.
                        </p>

                        <div class="plan-info">
                            <span>3 dage / uge</span>
                            <span>6 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

                <div class="plan-card">
                    <div class="plan-image strength"></div>

                    <div class="plan-content">
                        <span class="plan-level">STYRKE</span>

                        <h2>STRENGTH BUILD</h2>

                        <p>
                            Byg styrke og muskelmasse gennem progressive løft og basisøvelser.
                        </p>

                        <div class="plan-info">
                            <span>4 dage / uge</span>
                            <span>8 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

                <div class="plan-card">
                    <div class="plan-image lean"></div>

                    <div class="plan-content">
                        <span class="plan-level">LEAN</span>

                        <h2>LEAN & TONED</h2>

                        <p>
                            Effektiv kombination af styrke og cardio med fokus på definition.
                        </p>

                        <div class="plan-info">
                            <span>5 dage / uge</span>
                            <span>10 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

                <!-- ROW 2 -->

                <div class="plan-card">
                    <div class="plan-image athlete"></div>

                    <div class="plan-content">
                        <span class="plan-level">ATHLETE</span>

                        <h2>ATHLETE PERFORMANCE</h2>

                        <p>
                            Performance-plan med fokus på power, kondition og eksplosivitet.
                        </p>

                        <div class="plan-info">
                            <span>5 dage / uge</span>
                            <span>12 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

                <div class="plan-card">
                    <div class="plan-image classic1"></div>

                    <div class="plan-content">
                        <span class="plan-level">FITNESS</span>

                        <h2>FITLIFE CONDITIONING</h2>

                        <p>
                            Moderne fitnessprogram med fokus på energi og udholdenhed.
                        </p>

                        <div class="plan-info">
                            <span>4 dage / uge</span>
                            <span>7 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

                <div class="plan-card">
                    <div class="plan-image classic2"></div>

                    <div class="plan-content">
                        <span class="plan-level">BALANCE</span>

                        <h2>CORE & MOBILITY</h2>

                        <p>
                            Fokus på core, mobilitet og stabilitet gennem kontrollerede workouts.
                        </p>

                        <div class="plan-info">
                            <span>3 dage / uge</span>
                            <span>5 uger</span>
                        </div>

                        <button class="plan-btn">SE PLAN</button>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>