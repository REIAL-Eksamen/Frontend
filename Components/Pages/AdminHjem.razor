@page "/adminhjem"

<PageTitle>Admin - FitLife</PageTitle>

<div class="admin-container">
    <div class="admin-welcome">
        <div>
            <p class="admin-sub">Mandag, 26. maj 2026</p>
            <h1>Godmorgen, Admin</h1>
            <p class="admin-center">Scandinavian Center, Århus C</p>
        </div>
        <a href="/oprethold" class="btn-opret">OPRET HOLD</a>
    </div>

    <div class="admin-grid">
        <div class="admin-card today-card">
            <h3>Dagens hold</h3>
            <div class="hold-item">
                <span class="hold-tid">08:00</span>
                <span class="hold-navn">Pilates</span>
                <span class="hold-instruktør">Mette Christensen</span>
                <span class="hold-pladser">12/15 pladser</span>
                <span class="hold-status aktiv">Aktiv</span>
            </div>
            <div class="hold-item">
                <span class="hold-tid">10:30</span>
                <span class="hold-navn">Yoga</span>
                <span class="hold-instruktør">Bettina Hansen</span>
                <span class="hold-pladser">8/20 pladser</span>
                <span class="hold-status aktiv">Aktiv</span>
            </div>
            <div class="hold-item">
                <span class="hold-tid">12:00</span>
                <span class="hold-navn">Vand Aerobic</span>
                <span class="hold-instruktør">Torsten Torbensen</span>
                <span class="hold-pladser">20/20 pladser</span>
                <span class="hold-status fuld">Fuld</span>
            </div>
            <div class="hold-item">
                <span class="hold-tid">17:00</span>
                <span class="hold-navn">Stram op</span>
                <span class="hold-instruktør">Dennis Knudsen</span>
                <span class="hold-pladser">5/15 pladser</span>
                <span class="hold-status kommende">Kommende</span>
            </div>
        </div>

        <div class="admin-card stats-card">
            <h3>Dagens overblik</h3>
            <div class="stat-item">
                <span class="stat-label">Aktive medlemmer</span>
                <span class="stat-value">342</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Bookinger i dag</span>
                <span class="stat-value">87</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Hold i dag</span>
                <span class="stat-value">8</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Nye medlemmer denne uge</span>
                <span class="stat-value">12</span>
            </div>
        </div>
    </div>
</div>