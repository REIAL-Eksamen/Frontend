@page "/"

<PageTitle>Log ind - FitLife</PageTitle>

<div class="login-container">
    <div class="login-box">
        <div class="login-logo">
            <span class="logo-fit">FIT</span><span class="logo-life">LIFE</span>
        </div>
        <p class="login-sub">Log ind på din konto</p>

        <div class="form-group">
            <label>Email</label>
            <input type="email" placeholder="din@email.dk" class="form-input" />
        </div>

        <div class="form-group">
            <label>Adgangskode</label>
            <input type="password" placeholder="••••••••" class="form-input" />
        </div>

        <button class="btn-login">LOG IND</button>

        <p class="forgot">Glemt adgangskode?</p>
    </div>
</div>