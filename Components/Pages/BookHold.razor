@page "/bookhold"
@using Frontend.Models
@using Frontend.Services
@inject ClassClientService ClassClientService

<PageTitle>Book et hold - FitLife</PageTitle>

<div class="booking-page">
    <div class="booking-overlay">
        <h1>BOOK ET HOLD</h1>
        <p>DU KAN SE ALLE HOLD HERUNDER - OP TIL 14 DAGE FREM.</p>

        <div class="filters">
            <select class="filter-select">
                <option>Vælg Center ▼</option>
            </select>
            <select class="filter-select">
                <option>Vælg Hold ▼</option>
            </select>
            <select class="filter-select">
                <option>Vælg Instruktør ▼</option>
            </select>
            <select class="filter-select">
                <option>Vælg Dato ▼</option>
            </select>
            <button class="btn-search">SØG</button>
            <button class="btn-reset">RYD FILTRE</button>
        </div>

        <div class="class-list">
            @if (isLoading)
            {
                <p>Indlæser hold...</p>
            }
            else if (errorMessage is not null)
            {
                <p>@errorMessage</p>
            }
            else if (classes.Count == 0)
            {
                <p>Ingen hold fundet.</p>
            }
            else
            {
                @foreach (var item in classes)
                {
                    <div class="class-item">
                        <span>@item.CenterName</span>
                        <span>@item.ClassName</span>
                        <span>@item.InstructorName</span>
                        <span>@(item.StartTime?.ToString("d/M HH:mm") ?? "Tid mangler")</span>

                        @if (item.Status == "Scheduled" || item.Status == "Active")
                        {
                            <button class="btn-tilmeld">TILMELD</button>
                        }
                        else
                        {
                            <button class="btn-venteliste">VENTELISTE</button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ClassOverviewModel> classes = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            classes = await ClassClientService.GetClassOverview();
        }
        catch (Exception ex)
        {
            errorMessage = "Kunne ikke hente hold fra ClassService.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}