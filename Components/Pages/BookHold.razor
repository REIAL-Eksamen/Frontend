@page "/bookhold"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Opret Hold - FitLife</PageTitle>

<div class="oprethold-container">
    <div class="oprethold-header">
        <h1>Opret Hold</h1>
        <p class="oprethold-sub">Udfyld oplysningerne for det nye hold</p>
    </div>

    @if (successMessage is not null)
    {
        <div class="alert-success">@successMessage</div>
    }
    @if (errorMessage is not null)
    {
        <div class="alert-error">@errorMessage</div>
    }

    <div class="oprethold-form">
        <div class="form-section">
            <h3>Hold oplysninger</h3>

            <div class="form-group">
                <label>Holdskabelon</label>
                <select class="form-input" @bind="selectedTemplateId">
                    <option value="">Vælg skabelon</option>
                    @foreach (var t in templates)
                    {
                        <option value="@t.Id">@t.ClassName (@t.ClassType)</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-section">
            <h3>Tid og sted</h3>

            <div class="form-row">
                <div class="form-group">
                    <label>Startdato og tid</label>
                    <input type="datetime-local" class="form-input" @bind="startTime" />
                </div>
                <div class="form-group">
                    <label>Slutdato og tid</label>
                    <input type="datetime-local" class="form-input" @bind="endTime" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Center</label>
                    <select class="form-input" @bind="selectedCenterId">
                        <option value="">Vælg center</option>
                        @foreach (var c in centers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Lokale</label>
                    <select class="form-input" @bind="selectedClassroomId">
                        <option value="">Vælg lokale</option>
                        @foreach (var r in AvailableClassrooms)
                        {
                            <option value="@r.ClassroomId">@r.ClassroomName (max @r.Capacity)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Instruktør ID</label>
                <input type="text" class="form-input" placeholder="Indsæt instruktør ID"
                       @bind="instructorId" />
            </div>
        </div>

        <div class="form-actions">
            <a href="/hold" class="btn-annuller">ANNULLER</a>
            <button class="btn-opret" @onclick="OpretHold">OPRET HOLD</button>
        </div>
    </div>
</div>

@code {
    private List<ClassTemplate> templates = new();
    private List<Center> centers = new();

    private string selectedTemplateId = "";
    private string selectedCenterId = "";
    private string selectedClassroomId = "";
    private string instructorId = "";
    private DateTime? startTime;
    private DateTime? endTime;

    private string? successMessage;
    private string? errorMessage;

    private List<ClassroomDto> AvailableClassrooms =>
        centers.FirstOrDefault(c => c.Id == selectedCenterId)?.Classrooms ?? new();

    protected override async Task OnInitializedAsync()
    {
        templates = await Http.GetFromJsonAsync<List<ClassTemplate>>("http://classservice:8080/api/classtemplates") ?? new();
        centers = await Http.GetFromJsonAsync<List<Center>>("http://classservice:8080/api/centers") ?? new();
    }

    private async Task OpretHold()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrEmpty(selectedTemplateId) || string.IsNullOrEmpty(selectedCenterId) ||
            string.IsNullOrEmpty(selectedClassroomId) || string.IsNullOrEmpty(instructorId) ||
            startTime is null || endTime is null)
        {
            errorMessage = "Udfyld venligst alle felter.";
            return;
        }

        var classroom = AvailableClassrooms.FirstOrDefault(r => r.ClassroomId == selectedClassroomId);

        var dto = new CreateClassDTO
        {
            ClassTemplateId = selectedTemplateId,
            InstructorId = instructorId,
            CenterId = selectedCenterId,
            Classroom = classroom!,
            StartTime = startTime,
            EndTime = endTime
        };

        var response = await Http.PostAsJsonAsync("http://classservice:8080/api/class", dto);

        if (response.IsSuccessStatusCode)
            successMessage = "Holdet er oprettet!";
        else
            errorMessage = $"Fejl ved oprettelse: {response.StatusCode}";
    }

    // Lokale modelklasser
    public class ClassTemplate
    {
        public string? Id { get; set; }
        public string ClassName { get; set; } = "";
        public string ClassType { get; set; } = "";
    }

    public class Center
    {
        public string? Id { get; set; }
        public string Name { get; set; } = "";
        public List<ClassroomDto> Classrooms { get; set; } = new();
    }

    public class ClassroomDto
    {
        public string ClassroomId { get; set; } = "";
        public string ClassroomName { get; set; } = "";
        public int Capacity { get; set; }
    }

    public class CreateClassDTO
    {
        public string ClassTemplateId { get; set; } = "";
        public string InstructorId { get; set; } = "";
        public string CenterId { get; set; } = "";
        public ClassroomDto Classroom { get; set; } = new();
        public DateTime? StartTime { get; set; }
        public DateTime? EndTime { get; set; }
    }
}