@page "/bookhold"
@using Frontend.Models
@using Frontend.Services
@inject ClassClientService ClassClientService
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Holdbooking - FitLife</PageTitle>

<h1>BOOK ET HOLD</h1>
<p>DU KAN SE ALLE HOLD HERUNDER - OP TIL 14 DAGE FREM.</p>

<div class="filters">
    <select class="filter-select">
        <option>Vælg Center ▼</option>
    </select>
    <select class="filter-select">
        <option>Vælg Hold ▼</option>
    </select>
    <select class="filter-select">
        <option>Vælg Instruktør ▼</option>
    </select>
    <select class="filter-select">
        <option>Vælg Dato ▼</option>
    </select>
    <button class="btn-search">SØG</button>
    <button class="btn-reset">RYD FILTRE</button>
</div>
 
<div class="class-list">
            @if (isLoading)
            {
                <p>Indlæser hold...</p>
            }
            else if (classes.Count == 0)
            {
                <p>Ingen hold fundet.</p>
            }
            else
            {
                @foreach (var item in classes)
                {
                    <div class="class-item">
                        <span>@item.ClassName</span>
                        <span>@item.ClassDescription</span>
                        <span>@item.ClassType</span>
                        <span>@item.InstructorId</span>
                        <span>@(item.StartTime?.ToString("d/M HH:mm") ?? "Tid mangler")</span>
                        
                        <button class="btn-tilmeld" @onclick="() => JoinClass(item.Id)">
                            TILMELD
                        </button>
                    </div>
                }
            }
        </div>


@code {

    private List<ClassModel> classes = new();
    private bool isLoading = true;
    
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            classes = await Http.GetFromJsonAsync<List<ClassModel>>("http://classservice:8080/api/class") ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task JoinClass(string classId)
    {
        Console.WriteLine($"JOIN CLICK: {classId}");

        await ClassClientService.AddMember(classId);
    }
}