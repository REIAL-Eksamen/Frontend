@page "/hold"

<PageTitle>Hold - FitLife</PageTitle>

<div class="hold-container">
    <div class="hold-header">
        <div>
            <h1>Hold</h1>
            <p class="hold-sub">Oversigt over alle hold</p>
        </div>
        <a href="/oprethold" class="btn-opret">+ OPRET HOLD</a>
    </div>

    <div class="hold-list">
        <div class="hold-item">
            <div class="hold-info">
                <span class="hold-navn">Pilates</span>
                <span class="hold-type">Yoga</span>
                <span class="hold-tid">Man 08:00 - 09:00</span>
                <span class="hold-instruktør">Mette Christensen</span>
                <span class="hold-pladser">12/15 pladser</span>
            </div>
            <span class="hold-status aktiv">Aktiv</span>
        </div>
        <div class="hold-item">
            <div class="hold-info">
                <span class="hold-navn">Vand Aerobic</span>
                <span class="hold-type">Svømning</span>
                <span class="hold-tid">Tir 12:00 - 13:00</span>
                <span class="hold-instruktør">Torsten Torbensen</span>
                <span class="hold-pladser">20/20 pladser</span>
            </div>
            <span class="hold-status fuld">Fuld</span>
        </div>
        <div class="hold-item">
            <div class="hold-info">
                <span class="hold-navn">Stram op</span>
                <span class="hold-type">Styrke</span>
                <span class="hold-tid">Ons 17:00 - 18:00</span>
                <span class="hold-instruktør">Dennis Knudsen</span>
                <span class="hold-pladser">5/15 pladser</span>
            </div>
            <span class="hold-status aktiv">Aktiv</span>
        </div>
    </div>
</div>